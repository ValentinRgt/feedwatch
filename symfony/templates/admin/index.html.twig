{% extends "@layouts/administration.html.twig" %}

{% block title %}{{ 'pages.admin.index.title'|trans }}{% endblock %}

{% block body %}
    <div class="grid gap-6 mb-8 md:grid-cols-2 xl:grid-cols-4">
        <div class="min-w-0 rounded-lg shadow-xs overflow-hidden bg-white">
            <div class="p-4 flex items-center">
                <div class="p-3 rounded-full text-orange-500 bg-orange-100 mr-4">
                    {{ ux_icon('bi:rss-fill') }}
                </div>
                <div>
                    <p class="mb-2 text-md font-medium text-gray-600">
                        {{ 'pages.admin.index.stats.sources'|trans }}
                    </p>
                    <p class="text-lg font-semibold text-gray-700">
                        {{ sources|number_format }}
                    </p>
                </div>
            </div>
        </div>
        <div class="min-w-0 rounded-lg shadow-xs overflow-hidden bg-white">
            <div class="p-4 flex items-center">
                <div class="p-3 rounded-full text-green-500 bg-green-100 mr-4">
                    {{ ux_icon('bi:bookmark-fill') }}
                </div>
                <div>
                    <p class="mb-2 text-md font-medium text-gray-600">
                        {{ 'pages.admin.index.stats.categories'|trans }}
                    </p>
                    <p class="text-lg font-semibold text-gray-700">
                        {{ categories|number_format }}
                    </p>
                </div>
            </div>
        </div>
        <div class="min-w-0 rounded-lg shadow-xs overflow-hidden bg-white">
            <div class="p-4 flex items-center">
                <div class="p-3 rounded-full text-blue-500 bg-blue-100 mr-4">
                    {{ ux_icon('bi:newspaper') }}
                </div>
                <div>
                    <p class="mb-2 text-md font-medium text-gray-600">
                        {{ 'pages.admin.index.stats.feeds'|trans }}
                    </p>
                    <p class="text-lg font-semibold text-gray-700">
                        {{ feeds|number_format }}
                    </p>
                </div>
            </div>
        </div>
        <a href="{{ path('app.admin.monitoring.index') }}" class="min-w-0 rounded-lg shadow-xs overflow-hidden bg-white hover:bg-gray-50">
            <div class="p-4 flex items-center">
                <div class="p-3 rounded-full text-red-500 bg-red-100 mr-4">
                    {{ ux_icon('bi:exclamation-triangle-fill') }}
                </div>
                <div>
                    <p class="mb-2 text-md font-medium text-gray-600">
                        {{ 'pages.admin.index.stats.errors'|trans }}
                    </p>
                    <p class="text-lg font-semibold text-gray-700">
                        {{ errors|number_format }}
                    </p>
                </div>
            </div>
        </a>
    </div>

    {% set sections = [
        {
            name_label: 'pages.admin.index.most_active.table.source',
            route: 'app.admin.source.edit',
            tables: [
                { title: 'pages.admin.index.most_active.sources_30_days', rows: mostActiveSources30Days },
                { title: 'pages.admin.index.most_active.sources_7_days', rows: mostActiveSources7Days }
            ]
        },
        {
            name_label: 'pages.admin.index.most_active.table.category',
            route: 'app.admin.category.edit',
            tables: [
                { title: 'pages.admin.index.most_active.categories_30_days', rows: mostActiveCategories30Days },
                { title: 'pages.admin.index.most_active.categories_7_days', rows: mostActiveCategories7Days }
            ]
        }
    ] %}

    {% for section in sections %}
        <div class="grid gap-6 md:grid-cols-2 mb-8">
            {% for table in section.tables %}
                <div class="min-w-0 overflow-hidden">
                    <h2 class="text-lg font-semibold text-gray-700 mb-2">{{ table.title|trans }}</h2>
                    <div class="overflow-x-auto rounded-b-lg shadow-xs mb-4">
                        <table class="w-full text-sm text-left text-gray-500">
                            <thead class="text-xs text-white uppercase bg-gray-800">
                                <tr>
                                    <th scope="col" class="px-6 py-3 w-12">
                                        {{ 'pages.admin.index.most_active.table.rank'|trans }}
                                    </th>
                                    <th scope="col" class="px-6 py-3">
                                        {{ section.name_label|trans }}
                                    </th>
                                    <th scope="col" class="px-6 py-3 text-right">
                                        {{ 'pages.admin.index.most_active.table.articles'|trans }}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in table.rows %}
                                    <tr class="bg-white border-b border-gray-200">
                                        <td class="px-6 py-3 font-medium text-gray-900">
                                            {{ loop.index }}
                                        </td>
                                        <td class="px-6 py-3 font-medium text-gray-900 whitespace-nowrap">
                                            <a href="{{ path(section.route, { id: row.id }) }}" class="hover:underline">
                                                {{ row.name }}
                                            </a>
                                        </td>
                                        <td class="px-6 py-3 text-right text-gray-700">
                                            {{ row.articleCount|number_format }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% if table.rows is empty %}
                        {% include "@components/_alert.html.twig" with {
                            label: 'info',
                            message: 'pages.admin.index.most_active.empty'|trans
                        } %}
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}
