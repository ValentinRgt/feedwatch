{% extends '@layouts/administration.html.twig' %}

{% block title %}{{ 'pages.admin.articles.index.title'|trans }}{% endblock %}

{% block body %}
    <section class="p-6 bg-white rounded mb-3">
        <div class="flex flex-column sm:flex-row flex-wrap gap-4 items-center justify-between">
            <h1 class="text-xl font-bold">{{ 'pages.admin.articles.index.table.title'|trans }}</h1>
            {% include '@components/_search_bar.html.twig' with {
                label: 'pages.admin.articles.index.search.label'|trans,
                placeholder: 'pages.admin.articles.index.search.placeholder'|trans
            } %}
            {% include '@components/_page_size.html.twig' %}
        </div>
    </section>

    {% include '@components/_flash_messages.html.twig' %}

    <div class="overflow-x-auto shadow-md rounded-lg">
        <table class="w-full text-sm text-left rtl:text-right text-gray-500">
            <thead class="text-xs text-white uppercase bg-gray-800">
            <tr>
                <th scope="col" class="px-6 py-3">
                    {{ 'pages.admin.articles.index.table.title_column'|trans }}
                </th>
                <th scope="col" class="px-6 py-3">
                    {{ 'pages.admin.articles.index.table.source'|trans }}
                </th>
                <th scope="col" class="px-6 py-3">
                    {{ 'pages.admin.articles.index.table.category'|trans }}
                </th>
                <th scope="col" class="px-6 py-3 whitespace-nowrap">
                    {{ 'pages.admin.articles.index.table.published_at'|trans }}
                </th>
                <th scope="col" class="px-6 py-3 whitespace-nowrap">
                    {{ 'pages.admin.articles.index.table.created_at'|trans }}
                </th>
                <th scope="col" class="text-right px-6 py-3">
                    {{ 'pages.admin.articles.index.table.actions'|trans }}
                </th>
            </tr>
            </thead>
            <tbody data-controller="row-actions">
            {% for article in articles %}
                <tr class="bg-white border-b border-gray-200">
                    <th scope="row" class="px-6 py-4 font-medium text-gray-900">
                        <span class="line-clamp-2" title="{{ article.title }}">{{ article.title }}</span>
                    </th>
                    <td class="px-6 py-4 whitespace-nowrap">
                        {{ article.source ? article.source.name : '' }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        {{ article.source and article.source.category
                        ? article.source.category.name
                        : 'pages.admin.articles.index.no_category'|trans }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        {{ article.publishedAt
                        ? article.publishedAt|date
                        : 'pages.admin.articles.index.not_published'|trans }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        {{ article.createdAt|date }}
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex items-center justify-end">
                            <a href="{{ article.link }}" target="_blank" rel="noopener noreferrer"
                               class="px-4 py-2 cursor-pointer text-sm font-medium text-white bg-gray-800 hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 rounded-s-lg">
                                {{ ux_icon('bi:eye') }}
                            </a>
                            <form
                                method="post"
                                action="{{ path('app.admin.article.delete', { id: article.id }) }}"
                                data-action="row-actions#confirm"
                                data-row-actions-title-param="{{ 'pages.admin.articles.index.delete.confirm.title'|trans }}"
                                data-row-actions-text-param="{{ 'pages.admin.articles.index.delete.confirm.text'|trans({ '%title%': article.title }) }}"
                                data-row-actions-confirm-param="{{ 'pages.admin.articles.index.delete.confirm.confirm'|trans }}"
                                data-row-actions-cancel-param="{{ 'pages.admin.articles.index.delete.confirm.cancel'|trans }}"
                            >
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
                                <button type="submit"
                                        class="px-4 py-2 cursor-pointer text-sm font-medium text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:ring-red-300 rounded-e-lg">
                                    {{ ux_icon('bi:trash') }}
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if articles.getTotalItemCount is same as(0) %}
        {% include "@components/_alert.html.twig" with {
            label: 'info',
            message: 'pages.admin.articles.index.empty'|trans
        } %}
    {% endif %}

    {% if articles.getTotalItemCount > articles.getItemNumberPerPage %}
        <section id="pagination">
            <div class="flex p-6 bg-white rounded justify-center">
                {{ knp_pagination_render(articles) }}
            </div>
        </section>
    {% endif %}
{% endblock %}
