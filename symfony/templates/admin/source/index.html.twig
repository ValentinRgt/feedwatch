{% extends '@layouts/administration.html.twig' %}

{% block title %}{{ 'pages.admin.sources.index.title'|trans }}{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if form.vars.submitted and not form.vars.valid %}
        <script>
            (function reopenCreateModal() {
                const instance = window.FlowbiteInstances
                    && window.FlowbiteInstances.getInstance('Modal', 'create-modal');

                if (instance) {
                    instance.show();
                } else {
                    setTimeout(reopenCreateModal, 50);
                }
            })();
        </script>
    {% endif %}
{% endblock %}

{% block body %}
    <section class="p-6 bg-white rounded mb-3">
        <div class="flex flex-column sm:flex-row flex-wrap space-y-4 sm:space-y-0 items-center justify-between">
            <h1 class="text-xl font-bold">{{ 'pages.admin.sources.index.table.title'|trans }}</h1>
            {% include '@components/_search_bar.html.twig' with {
                label: 'pages.admin.sources.index.search.label'|trans,
                placeholder: 'pages.admin.sources.index.search.placeholder'|trans
            } %}
            <div class="inline-flex">
                <button data-modal-target="create-modal" data-modal-toggle="create-modal"
                        class="me-3 text-white bg-gray-800 hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-3 py-2 focus:outline-none cursor-pointer">
                    {{ 'pages.admin.sources.index.add_source'|trans }}
                </button>
                {% include '@components/_page_size.html.twig' %}
            </div>
        </div>
    </section>

    {% include '@components/_flash_messages.html.twig' %}

    <div id="create-modal" tabindex="-1" aria-hidden="true"
         class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 bg-gray-900/50 w-full inset-0 h-full">
        <div class="relative p-4 w-full max-w-5xl max-h-full self-start justify-self-center">
            <!-- Modal content -->
            <div class="relative bg-white rounded-lg shadow-sm">
                <!-- Modal header -->
                <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t border-gray-200">
                    <h3 class="text-xl font-semibold text-gray-900">
                        {{ 'pages.admin.sources.index.modal.title'|trans }}
                    </h3>
                    <button type="button"
                            class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center"
                            data-modal-hide="create-modal">
                        <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none"
                             viewBox="0 0 14 14">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                        </svg>
                        <span class="sr-only">Close modal</span>
                    </button>
                </div>
                <!-- Modal body -->
                <div class="p-4 md:p-5 space-y-4">
                    {{ form_start(form) }}
                    {{ form_row(form.name) }}
                    {{ form_row(form.url) }}
                    {{ form_row(form.category) }}
                    {{ form_row(form.format) }}
                    {{ form_row(form.periodicity) }}
                    {{ form_row(form.status) }}
                    <button type="submit"
                            class="w-full col-span-2 text-white bg-gray-800 hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-5 py-2.5 focus:outline-none cursor-pointer">
                        {{ 'pages.admin.sources.index.modal.submit'|trans }}
                    </button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <div class="overflow-x-auto shadow-md rounded-lg">
        <table class="w-full text-sm text-left rtl:text-right text-gray-500">
            <thead class="text-xs text-white uppercase bg-gray-800">
            <tr>
                <th scope="col" class="px-6 py-3">
                    {{ 'pages.admin.sources.index.table.name'|trans }}
                </th>
                <th scope="col" class="px-6 py-3">
                    {{ 'pages.admin.sources.index.table.category'|trans }}
                </th>
                <th scope="col" class="px-6 py-3">
                    {{ 'pages.admin.sources.index.table.format'|trans }}
                </th>
                <th scope="col" class="px-6 py-3">
                    {{ 'pages.admin.sources.index.table.status'|trans }}
                </th>
                <th scope="col" class="px-6 py-3">
                    {{ 'pages.admin.sources.index.table.created_at'|trans }}
                </th>
                <th scope="col" class="px-6 py-3">
                    {{ 'pages.admin.sources.index.table.last_fetched_at'|trans }}
                </th>
                <th scope="col" class="px-6 py-3">
                    {{ 'pages.admin.sources.index.table.updated_at'|trans }}
                </th>
                <th scope="col" class="text-right px-6 py-3">
                    {{ 'pages.admin.sources.index.table.actions'|trans }}
                </th>
            </tr>
            </thead>
            <tbody data-controller="row-actions">
            {% for source in sources %}
                <tr class="{% if source.status == constant('App\\Enum\\StatusEnum::IN_ERROR') %}bg-red-200{% else %}bg-white{% endif %} border-b border-gray-200">
                    <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap">
                        {{ source.name }}
                    </th>
                    <td class="px-6 py-4">
                        {{ source.category ? source.category.name : "pages.admin.sources.index.no_category"|trans }}
                    </td>
                    <td class="px-6 py-4">
                        {{ source.format|trans }}
                    </td>
                    <td class="px-6 py-4">
                        {{ source.status|trans }}
                    </td>
                    <td class="px-6 py-4">
                        {{ source.createdAt|date }}
                    </td>
                    <td class="px-6 py-4">
                        {{ source.lastFetchedAt ? source.lastFetchedAt|date : "pages.admin.sources.index.not_updated"|trans }}
                    </td>
                    <td class="px-6 py-4">
                        {{ source.updatedAt ? source.updatedAt|date : "pages.admin.sources.index.not_updated"|trans }}
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex items-center justify-end">
                            <a href="{{ path('app.admin.source.edit', { id: source.id }) }}"
                               class="px-4 py-2 cursor-pointer text-sm font-medium text-white bg-gray-800 hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 rounded-s-lg">
                                {{ ux_icon('bi:pencil') }}
                            </a>
                            <form
                                method="post"
                                action="{{ path('app.admin.source.delete', { id: source.id }) }}"
                                data-action="row-actions#confirm"
                                data-row-actions-title-param="{{ 'pages.admin.categories.index.delete.confirm.title'|trans }}"
                                data-row-actions-text-param="{{ 'pages.admin.categories.index.delete.confirm.text'|trans({ '%name%': source.name }) }}"
                                data-row-actions-confirm-param="{{ 'pages.admin.categories.index.delete.confirm.confirm'|trans }}"
                                data-row-actions-cancel-param="{{ 'pages.admin.categories.index.delete.confirm.cancel'|trans }}"
                            >
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ source.id) }}">
                                <button type="submit"
                                        class="px-4 py-2 cursor-pointer text-sm font-medium text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:ring-red-300 rounded-e-lg">
                                    {{ ux_icon('bi:trash') }}
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if sources|length is same as(0) %}
        <div class="flex items-center p-4 mt-4 text-sm text-blue-800 rounded-lg bg-blue-50" role="alert">
            <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                 fill="currentColor" viewBox="0 0 20 20">
                <path
                    d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
            </svg>
            <span class="sr-only">Info</span>
            <div>
                {{ 'pages.admin.categories.index.no_categories'|trans }}
            </div>
        </div>
    {% endif %}

    {% if sources.getTotalItemCount > sources.getItemNumberPerPage %}
        <section id="pagination">
            <div class="flex p-6 bg-white rounded justify-center">
                {{ knp_pagination_render(sources) }}
            </div>
        </section>
    {% endif %}
{% endblock %}
