{{ form_start(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.url) }}
    {{ form_row(form.category) }}
    {{ form_row(form.format) }}
    {{ form_row(form.periodicity) }}
    {{ form_row(form.status) }}
<div class="{% if form.format.vars.value != 'html' %}hidden{% endif %} col-span-2 border-t border-gray-200 pt-4"
    data-format-toggle-target="block">
    <div class="flex items-center justify-between mb-4">
        <h4 class="text-md font-semibold text-gray-900">
            {{ 'pages.admin.sources.form.html_scraping.title'|trans }}
        </h4>
        {% set wiki_url = github_repo_url ~ '/wiki/Sources#scraping-html' %}
        <a href="{{ wiki_url }}" target="_blank"
            class="inline-flex items-center text-white bg-gray-800 hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-3 py-1.5 focus:outline-none">
            {{ ux_icon('bi:github', { class: 'me-2' }) }}
            <span>{{ 'pages.admin.sources.form.html_scraping.documentation'|trans }}</span>
        </a>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
        {{ form_row(form.itemContainer) }}
        {{ form_row(form.itemTitle) }}
        {{ form_row(form.itemLink) }}
        {{ form_row(form.itemPublishedAt) }}
    </div>
</div>
<button type="submit"
        class="w-full col-span-2 text-white bg-gray-800 hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-5 py-2.5 focus:outline-none cursor-pointer">
    {{ 'pages.admin.sources.edit.submit'|trans }}
</button>
{{ form_end(form) }}
