{% extends "@layouts/base.html.twig" %}

{% block sidebar %}
    <aside id="logo-sidebar" class="fixed top-0 left-0 z-40 w-72 h-screen pt-20 transition-transform -translate-x-full bg-gray-800 border-r border-gray-700 lg:translate-x-0" aria-label="Sidebar">
        <div class="h-full px-3 pb-4 overflow-y-auto bg-gray-800 [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-gray-300">
            <ul class="space-y-2 font-medium">
                <li>
                    <a href="{{ path('app.admin.source.index') }}" class="flex items-center p-2 text-white rounded-lg hover:bg-gray-700 group">
                        {{ ux_icon('bi:rss-fill') }}
                        <span class="ms-3 truncate">{{ 'navigation.sidebar.sources'|trans }}</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app.admin.category.index') }}" class="flex items-center p-2 text-white rounded-lg hover:bg-gray-700 group">
                        {{ ux_icon('bi:bookmark-fill') }}
                        <span class="ms-3 truncate">{{ 'navigation.sidebar.categories'|trans }}</span>
                    </a>
                </li>
            </ul>
        </div>
    </aside>
{% endblock %}
