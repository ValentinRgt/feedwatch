<div id="alert"
     class="flex items-center p-4 mb-4 text-md rounded-lg border {% if label == "info" %}text-blue-800 border-blue-300 bg-blue-50{% elseif label == "error" %}text-red-800 border-red-300 bg-red-50{% elseif label == "success" %}text-green-800 border-green-300 bg-green-50{% elseif label == "warning" %}text-yellow-800 border-yellow-300 bg-yellow-50{% else %}text-gray-800 border-gray-300 bg-gray-50{% endif %}"
     role="alert">
    <svg class="flex-shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
         fill="currentColor" viewbox="0 0 20 20">
        <path
            d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"></path>
    </svg>
    <span class="sr-only">Info</span>
    <div>{{ message }}</div>
    {% if close is defined %}
        <button type="button"
                class="ms-auto -mx-1.5 -my-1.5 focus:ring-2 p-1.5{% if label == "info" %}text-blue-800 border-blue-300 bg-blue-50 focus:ring-blue-400 hover:bg-blue-200{% elseif label == "error" %}text-red-800 border-red-300 bg-red-50 focus:ring-red-400 hover:bg-red-200{% elseif label == "success" %}text-green-800 border-green-300 bg-green-50 focus:ring-green-400 hover:bg-green-200{% elseif label == "warning" %}text-yellow-800 border-yellow-300 bg-yellow-50 focus:ring-yellow-400 hover:bg-yellow-200{% else %}text-gray-800 border-gray-300 bg-gray-50 focus:ring-gray-400 hover:bg-gray-200{% endif %} rounded-lg inline-flex items-center justify-center h-8 w-8"
                data-dismiss-target="#alert" aria-label="Close">
            <span class="sr-only">Close</span>
            <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
            </svg>
        </button>
    {% endif %}
</div>
