<form method="get" class="flex-1 sm:max-w-md w-full">
    <label for="search-query" class="sr-only">
        {{ label }}
    </label>
    <div class="relative">
        <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-500">
            {{ ux_icon('bi:search') }}
        </div>
        <input type="search" id="search-query" name="q" value="{{ app.request.query.get('q') }}"
            placeholder="{{ placeholder }}"
            class="block w-full p-2 ps-10 text-sm text-gray-900 border border-gray-200 rounded-lg bg-white focus:ring-2 focus:ring-gray-300 focus:outline-none">
    </div>
</form>
