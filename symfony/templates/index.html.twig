{% extends '@layouts/base.html.twig' %}

{% block title %}{{ 'pages.index.title'|trans }}{% endblock %}

{% block body %}
    <div class="text-sm font-medium text-center text-gray-500 border-b border-gray-200" data-controller="tabs-carousel">
        <div class="flex items-center">
            <button type="button"
                    data-tabs-carousel-target="prev"
                    data-action="tabs-carousel#prev"
                    aria-label="{{ 'pagination.previous'|trans }}"
                    class="hidden shrink-0 p-2 me-1 text-gray-500 rounded-full hover:bg-gray-100"
            >
                <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none"
                     viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M15 19l-7-7 7-7"/>
                </svg>
            </button>

            <div data-tabs-carousel-target="scroller"
                 class="flex-1 overflow-x-auto scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
                {% set tab_active = 'inline-block p-4 text-blue-600 border-b-2 border-blue-600 rounded-t-lg active' %}
                {% set tab_inactive = 'inline-block p-4 border-b-2 border-transparent rounded-t-lg hover:text-gray-600 hover:border-gray-300' %}
                <ul class="flex flex-nowrap -mb-px">
                    <li class="me-2 shrink-0">
                        <a href="{{ path('app.home') }}"
                           class="{{ selectedCategory is null ? tab_active : tab_inactive }}"
                           {% if selectedCategory is null %}aria-current="page"{% endif %}
                        >
                            {{ 'pages.index.all_feeds'|trans }}
                        </a>
                    </li>
                    {% for category in categories %}
                        {% set is_selected = selectedCategory and selectedCategory.id == category.id %}
                        <li class="me-2 shrink-0">
                            <a href="{{ path('app.home', { category: category.id }) }}"
                               class="{{ is_selected ? tab_active : tab_inactive }}"
                               {% if is_selected %}aria-current="page"{% endif %}
                            >
                                {{ category.name }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <button type="button"
                    data-tabs-carousel-target="next"
                    data-action="tabs-carousel#next"
                    aria-label="{{ 'pagination.next'|trans }}"
                    class="hidden shrink-0 p-2 ms-1 text-gray-500 rounded-full hover:bg-gray-100"
            >
                <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none"
                     viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        </div>
    </div>

    {% if feeds|length > 0 %}
        <div class="grid items-start gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {% for feed in feeds %}
                <article class="p-4 bg-white rounded-lg border border-gray-200 shadow-md">
                    <h2 class="mb-3 text-lg font-bold uppercase">
                        <a href="{{ feed.link }}" class="text-gray-800" target="_blank">
                            {{ feed.title }}
                        </a>
                    </h2>
                    <p class="text-md font-normal text-gray-500 inline-flex items-center">
                        {{ ux_icon('bi:calendar-week-fill', { class: 'me-2' }) }}
                        {% set published = feed.publishedAt ?? feed.createdAt %}
                        <span>{{ published|date }}</span>
                    </p>
                    <div>
                        <span
                            class="bg-blue-100 text-blue-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded-sm">{{ feed.source.name }}</span>
                        {% if feed.source.category is not defined %}
                            <span
                                class="bg-blue-100 text-blue-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded-sm">{{ feed.source.category.name }}</span>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>

        {% if feeds.getTotalItemCount > feeds.getItemNumberPerPage %}
            <section id="pagination">
                <div class="flex p-6 bg-white rounded justify-center">
                    {{ knp_pagination_render(feeds) }}
                </div>
            </section>
        {% endif %}
    {% else %}
        <div class="flex items-center p-4 text-sm text-blue-800 rounded-lg bg-blue-50" role="alert">
            <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                 fill="currentColor" viewBox="0 0 20 20">
                <path
                    d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
            </svg>
            <span class="sr-only">Info</span>
            <div>
                {{ 'pages.index.no_feeds'|trans }}
            </div>
        </div>
    {% endif %}
{% endblock %}
