{% if pageCount > 1 %}
    <nav class="flex">
        <ul class="inline-flex -space-x-px text-md">
            <li class="mr-4">
                {% if previous is defined %}
                    <a rel="prev" href="{{ path(route, query|merge({(pageParameterName): previous})) }}"
                        class="flex items-center justify-center px-4 h-11 ms-0 leading-tight text-gray-500 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 hover:text-gray-700">
                        <svg class="w-3.5 h-3.5 me-2 rtl:rotate-180" aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13 5H1m0 0 4 4M1 5l4-4"></path>
                        </svg>
                        {{ 'pagination.previous'|trans }}
                    </a>
                {% else %}
                    <span
                        class="flex items-center justify-center cursor-not-allowed px-4 h-11 ms-0 leading-tight text-gray-500 bg-white border border-gray-300 rounded-lg">
                        <svg class="w-3.5 h-3.5 me-2 rtl:rotate-180" aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13 5H1m0 0 4 4M1 5l4-4"></path>
                        </svg>
                        {{ 'pagination.previous'|trans }}
                    </span>
                {% endif %}
            </li>

            {% for page in pagesInRange %}
                <li class="px-2">
                    {% if page != current %}
                        <a href="{{ path(route, query|merge({(pageParameterName): page})) }}"
                            class="flex items-center justify-center px-4 h-11 leading-tight text-gray-500 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 hover:text-gray-700">{{ page }}</a>
                    {% else %}
                        <span aria-current="page"
                            class="flex items-center justify-center cursor-pointer px-4 h-11 text-blue-600 border border-gray-300 rounded-lg bg-blue-50 hover:bg-blue-100 hover:text-blue-700">{{ page }}</span>
                    {% endif %}
                </li>
            {% endfor %}

            <li class="pl-4">
                {% if next is defined %}
                    <a rel="next" href="{{ path(route, query|merge({(pageParameterName): next})) }}"
                       class="flex items-center justify-center px-4 h-11 leading-tight text-gray-500 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 hover:text-gray-700">
                        {{ 'pagination.next'|trans }}
                        <svg class="w-3.5 h-3.5 ms-2 rtl:rotate-180" aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M1 5h12m0 0L9 1m4 4L9 9"></path>
                        </svg>
                    </a>
                {% else %}
                    <span
                        class="flex items-center justify-center cursor-not-allowed px-4 h-11 leading-tight text-gray-500 bg-white border border-gray-300 rounded-lg">
                        {{ 'pagination.next'|trans }}
                        <svg class="w-3.5 h-3.5 ms-2 rtl:rotate-180" aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M1 5h12m0 0L9 1m4 4L9 9"></path>
                        </svg>
                    </span>
                {% endif %}
            </li>
        </ul>
    </nav>
{% endif %}
